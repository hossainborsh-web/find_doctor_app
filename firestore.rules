rules_version = '2';

// Find Doctor — who may read and change what.
//
// The hiring law lives here too, so it holds even if someone edits the app:
//  * Sign-up can only make a User, a Student or a New Doctor.
//  * Only HR (a General Manager, or a Doctor Manager for their own hospital)
//    can turn a Student or New Doctor into a Doctor, or end a Doctor's work.
//  * Only a General Manager can make or remove a Doctor Manager.
//  * Nobody can change their own role, hospital or status.
// The first General Manager is set by hand in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ who am I

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function myEmail() { return request.auth.token.email; }
    function meDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function myHospital() { return meDoc().get('hospital', ''); }
    function active() { return meDoc().get('status', 'active') == 'active'; }
    function isGM() {
      let me = meDoc();
      return me.get('status', 'active') == 'active'
        && me.get('managerLevel', null) == 'generalManager'
        && me.get('doctorKind', null) != 'doctorManager';
    }
    function isDM() {
      let me = meDoc();
      return me.get('status', 'active') == 'active'
        && (me.get('doctorKind', null) == 'doctorManager'
            || me.get('managerLevel', null) == 'doctorManager')
        && me.get('hospital', '') != '';
    }
    function isHr() { return isGM() || isDM(); }
    function hrFor(hospital) {
      return isGM() || (isDM() && myHospital().lower() == hospital.lower());
    }
    function practises() {
      let me = meDoc();
      return me.get('doctorKind', null) in ['doctor', 'doctorManager']
        || me.get('role', '') == 'manager'
        || me.get('managerLevel', null) != null;
    }
    function staffAt(hospital) {
      return hospital != ''
        && (isGM() || (active() && practises() && myHospital() == hospital));
    }

    function after() { return request.resource.data; }
    function before() { return resource.data; }
    function same(key) {
      return request.resource.data.get(key, null) == resource.data.get(key, null);
    }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------------------------------------------------------------- users

    function validNewUser(userId) {
      let d = after();
      return userId == uid()
        && d.get('email', '') == myEmail()
        && d.get('managerLevel', null) == null
        && d.get('status', 'active') == 'active'
        && d.get('hospital', '') == ''
        && d.get('hiredBy', null) in [null, '']
        && ((d.get('role', '') == 'patient' && d.get('doctorKind', null) == null)
            || (d.get('role', '') == 'doctor'
                && d.get('doctorKind', null) in ['student', 'newDoctor']));
    }

    // Personal details HR must never touch.
    function personalSame() {
      return same('fullName') && same('email') && same('birthday')
        && same('specialty') && same('university') && same('graduationYear')
        && same('certificatePath') && same('createdAt') && same('status');
    }

    // Anyone editing their own profile: names, career, certificate.
    function selfEdit(userId) {
      return userId == uid()
        && same('role') && same('doctorKind') && same('managerLevel')
        && same('hospital') && same('status') && same('email')
        && same('hiredBy') && same('hiredAt')
        && same('reviewedBy') && same('reviewedAt');
    }

    // HR completes hiring: Student / New Doctor becomes a Doctor.
    function hireEdit(userId) {
      return userId != uid()
        && before().get('doctorKind', null) in ['student', 'newDoctor']
        && before().get('status', 'active') == 'active'
        && after().get('role', '') == 'doctor'
        && after().get('doctorKind', null) == 'doctor'
        && after().get('managerLevel', null) == null
        && after().get('hospital', '') != ''
        && hrFor(after().get('hospital', ''))
        && personalSame();
    }

    // HR ends a Doctor's work: they become a New Doctor again. Doctor
    // Managers can only be released by a General Manager.
    function releaseEdit(userId) {
      return userId != uid()
        && before().get('doctorKind', null) in ['doctor', 'doctorManager']
        && before().get('hospital', '') != ''
        && hrFor(before().get('hospital', ''))
        && (before().get('doctorKind', null) == 'doctor' || isGM())
        && after().get('role', '') == 'doctor'
        && after().get('doctorKind', null) == 'newDoctor'
        && after().get('managerLevel', null) == null
        && after().get('hospital', '') == ''
        && personalSame();
    }

    // Only a General Manager gives or removes Doctor Manager.
    function doctorManagerEdit(userId) {
      return userId != uid()
        && isGM()
        && before().get('doctorKind', null) in ['doctor', 'doctorManager']
        && before().get('hospital', '') != ''
        && after().get('role', '') == 'doctor'
        && after().get('doctorKind', null) in ['doctor', 'doctorManager']
        && after().get('managerLevel', null) == null
        && same('hospital')
        && personalSame()
        && onlyChanged(['role', 'doctorKind', 'managerLevel']);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && validNewUser(userId);
      allow update: if signedIn()
        && (selfEdit(userId) || hireEdit(userId) || releaseEdit(userId)
            || doctorManagerEdit(userId));
      allow delete: if false;
    }

    // ------------------------------------------------------------ schedules

    match /schedules/{email} {
      allow read: if signedIn();
      allow write: if signedIn() && email == myEmail();
    }

    // -------------------------------------------------------- chat requests

    match /chatRequests/{id} {
      allow read: if signedIn()
        && (resource.data.patientEmail == myEmail()
            || resource.data.doctorEmail == myEmail());
      allow create: if signedIn() && after().get('patientEmail', '') == myEmail();
      allow update, delete: if signedIn()
        && (resource.data.patientEmail == myEmail()
            || resource.data.doctorEmail == myEmail());
    }

    // -------------------------------------------------------- conversations

    match /conversations/{id} {
      allow read: if signedIn()
        && (resource == null
            || myEmail() in resource.data.members
            || resource.data.type == 'community'
            || (resource.data.type == 'hospital'
                && staffAt(resource.data.hospital)));
      allow create: if signedIn()
        && (myEmail() in after().get('members', [])
            || after().get('type', '') == 'community'
            || (after().get('type', '') == 'hospital'
                && staffAt(after().get('hospital', ''))));
      allow update: if signedIn()
        && (myEmail() in before().get('members', [])
            || before().get('type', '') == 'community'
            || (before().get('type', '') == 'hospital'
                && staffAt(before().get('hospital', ''))));
      allow delete: if signedIn()
        && (myEmail() in before().get('members', [])
            || before().get('leaderEmail', '') == myEmail()
            || isGM());
    }

    // -------------------------------------------------------- notifications

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.recipient == myEmail();
      allow create: if signedIn()
        && after().get('recipient', '') is string
        && after().get('recipient', '') != '';
      allow update, delete: if signedIn()
        && resource.data.recipient == myEmail();
    }

    // --------------------------------------------------------------- visits

    match /visits/{id} {
      allow read: if signedIn()
        && (resource.data.patientEmail == myEmail()
            || resource.data.doctorEmail == myEmail()
            || isGM()
            || (isDM() && resource.data.hospital == myHospital()));
      allow create: if signedIn()
        && (after().get('patientEmail', '') == myEmail()
            || after().get('doctorEmail', '') == myEmail());
      allow update, delete: if signedIn()
        && (before().get('patientEmail', '') == myEmail()
            || before().get('doctorEmail', '') == myEmail()
            || hrFor(before().get('hospital', '')));
    }

    // Booked times, so two people can't book the same doctor at once.
    match /slots/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && after().get('owner', '') == uid();
      allow update: if false;
      allow delete: if signedIn()
        && (before().get('owner', '') == uid()
            || before().get('doctorEmail', '') == myEmail()
            || isHr());
    }

    // --------------------------------------------------------------- hiring

    match /hrCases/{id} {
      allow read: if signedIn()
        && (resource.data.seekerEmail == myEmail() || isHr());
      allow create: if signedIn()
        && ((after().get('seekerEmail', '') == myEmail()
             && after().get('status', '') == 'requested'
             && meDoc().get('doctorKind', null) in ['student', 'newDoctor'])
            || (after().get('status', '') == 'offered'
                && after().get('seekerEmail', '') != myEmail()
                && hrFor(after().get('hospital', ''))));
      allow update: if signedIn()
        && same('seekerEmail') && same('hospital')
        && ((before().get('seekerEmail', '') == myEmail()
             && after().get('status', '') in
                ['requested', 'scheduled', 'declined', 'withdrawn', 'closed'])
            || (before().get('seekerEmail', '') != myEmail()
                && hrFor(before().get('hospital', '')))
            || (isHr()
                && after().get('status', '') == 'closed'
                && onlyChanged(['status', 'note', 'updatedAt'])));
      allow delete: if false;
    }

    // ------------------------------------------------------------ inventory

    match /inventory/{id} {
      allow read: if signedIn()
        && (isGM()
            || (resource.data.hospital == myHospital()
                && active() && practises()));
      allow create, update: if signedIn() && staffAt(after().get('hospital', ''));
      allow delete: if signedIn() && staffAt(before().get('hospital', ''));
    }

    // ---------------------------------------------------------------- posts

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (after().get('authorUid', '') == uid()
            || (after().get('authorUid', '') == ''
                && (postId.matches('seed_.*') || postId.matches('reel_.*'))));
      allow update: if signedIn()
        && ((before().get('authorUid', '') == uid() && same('authorUid'))
            || onlyChanged(['likedBy', 'savedBy', 'viewedBy', 'comments']));
      allow delete: if signedIn()
        && ((before().get('authorUid', '') == uid()
             && before().get('authorUid', '') != '')
            || isGM());
    }

    match /follows/{email} {
      allow read: if signedIn();
      allow write: if signedIn() && email == myEmail();
    }

    // ---------------------------------------------------------------- media

    // Photos (shrunk JPEG, base64) referenced as "media:<id>".
    match /media/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && after().get('owner', '') == uid()
        && after().get('data', '') is string
        && after().get('data', '').size() < 1000000;
      allow update: if false;
      allow delete: if signedIn() && before().get('owner', '') == uid();
    }
  }
}
